    {
      "parameters": {
        "jsCode": "const output = $input.first().json;\nconst text = output.output[0].content[0].text;\nconst parsed = JSON.parse(text);\n\nreturn [{\n  json: {\n    reply: parsed.reply,\n    classification: parsed.classification,\n    reason: parsed.reason,\n    phone: $('Code in JavaScript: Clean Phone Number').item.json.phone\n  }\n}];"
      },
