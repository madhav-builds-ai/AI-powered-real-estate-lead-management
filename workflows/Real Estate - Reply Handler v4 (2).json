    },
    {
      "parameters": {
        "jsCode": "const existing = $('Get row(s) in sheet1: Get Conversation History').item.json?.['Conversation JSON']\n  ? JSON.parse($('Get row(s) in sheet1: Get Conversation History').item.json['Conversation JSON'])\n  : [];\n\nconst incomingMessage = $('Code in JavaScript: Clean Phone Number').item.json.message;\nconst aiReply = $('Code in JavaScript: Parse GPT Response').item.json.reply;\n\nconst updated = [\n  ...existing,\n  { \"role\": \"user\", \"content\": incomingMessage },\n  { \"role\": \"assistant\", \"content\": aiReply }\n];\n\nreturn [{\n  json: {\n    phone: $('Code in JavaScript: Clean Phone Number').item.json.phone,\n    conversation_json: JSON.stringify(updated)\n  }\n}];"
      },
