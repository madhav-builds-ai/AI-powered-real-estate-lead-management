    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nconst filtered = items.filter(item => {\n  const status = item.json['Status ']?.toLowerCase().trim();\n  const nextFollowUp = item.json['Next Follow Up At'];\n  const stage = item.json['Follow Up Stage'];\n\n  // Skip dead/cold/hot leads — FIRST check\n  if (['dead', 'cold', 'hot'].includes(status)) return false;\n\n  // If stage is empty, it's a new lead — include it\n  if (!stage) return true;\n\n  // If stage is empty or 1, it's early stage — include it\n  if (!stage || stage === '1') return true;\n\n  // Skip if no follow up date set\n  if (!nextFollowUp) return false;\n\n  // Skip if not due yet\n  if (new Date(nextFollowUp) > now) return false;\n\n  return true;\n});\n\nreturn filtered.map(item => ({ json: item.json }));"
      },
